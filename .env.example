# ================= JobLens 环境变量示例 =================
# 用法: 复制本文件为 .env 并填入真实值; .env 已被 .gitignore 忽略, 不会入库。

# ---------- LLM (任意 OpenAI-compatible 服务) ----------
# 与 DEEPSEEK_API_KEY 二选一, LLM_API_KEY 优先
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
# 模型名, 默认 deepseek-chat; 用阿里百炼可填 qwen3-max 等
#LLM_MODEL=deepseek-chat
# 接口地址, 默认 https://api.deepseek.com/v1
#LLM_BASE_URL=https://api.deepseek.com/v1
# 可选: 覆盖内置默认 temperature(0.3) / max_tokens(8192)
#LLM_TEMPERATURE=0.3
#LLM_MAX_TOKENS=8192
# 可选: 追加进请求体的模型私有参数(JSON)。
# Qwen3.x 等思考模型必须关掉思考模式才能走结构化输出(function_calling 依赖 tool_choice):
#LLM_EXTRA_BODY={"enable_thinking": false}

# ---------- Embedding (双模式) ----------
# EMBEDDING_BASE_URL 留空 → 本地模式(sentence-transformers, 首次启动下载模型)
# 配置后 → API 模式(OpenAI 兼容 embedding 接口, 推荐部署时使用)
# 注意: 切换模式后必须清空向量库目录(CHROMA_DIR), 两种模式的向量空间不可混用
#EMBEDDING_BASE_URL=
# 不填则回落 LLM_API_KEY
#EMBEDDING_API_KEY=
# API 模式填服务方模型名(如 text-embedding-v3);
# 本地模式默认 paraphrase-multilingual-MiniLM-L12-v2
#EMBEDDING_MODEL=

# ---------- 存储路径(默认都在用户主目录 ~/.joblens/ 下) ----------
#SQLITE_PATH=      # 历史分析记录 history.db
#CHROMA_DIR=       # 向量库 chroma/
#CHECKPOINT_PATH=  # 会话记忆 checkpoints.db

# ---------- CORS ----------
# 逗号分隔来源白名单; 留空默认放行 localhost 的 8000/5173 四个本机来源
#CORS_ORIGINS=

# ---------- LangSmith 可观测(可选) ----------
# 置 true 后 LangChain 自动上报 trace, 代码零改动
#LANGSMITH_TRACING=false
#LANGSMITH_API_KEY=
#LANGSMITH_ENDPOINT=https://api.smith.langchain.com
#LANGSMITH_PROJECT=JobLens
